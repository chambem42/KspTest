<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)../../build/KspPlugin.props" />
  <PropertyGroup>
    <RootNamespace>KspTest.Tests.RP1</RootNamespace>
    <IsPackable>false</IsPackable>
    <MechJebPath Condition="'$(MechJebPath)' == ''">$(KspGameData)/MechJeb2/Plugins</MechJebPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/KspTest/KspTest.csproj" Private="false" />
    <ProjectReference Include="../../src/KspTest.Trajectories/KspTest.Trajectories.csproj" Private="false" />
    <ProjectReference Include="../../src/KspTest.MechJeb/KspTest.MechJeb.csproj" Private="false" />
    <ProjectReference Include="../../src/KspTest.RP1/KspTest.RP1.csproj" Private="false" />
    <Reference Include="RP0" HintPath="$(KspGameData)/RP-1/Plugins/RP0.dll" Private="false" />
    <Reference Include="ROUtils" HintPath="$(KspGameData)/ROUtils/Plugins/ROUtils.dll" Private="false" />
    <Reference Include="MechJeb2" HintPath="$(MechJebPath)/MechJeb2.dll" Private="false" />
  </ItemGroup>
</Project>
