<Project Sdk="Microsoft.NET.Sdk">
  <!-- The source generator a dotnet test project gets with KspTest.Xunit: a [KspFact] for every [UITest] in the
       project's in-game assemblies (KspTestPlugin items), so the tests are written once, in the game. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
    <!-- it reads the in-game assemblies from disk, which the extended analyzer rules (RS1035) forbid; one diagnostic, untracked -->
    <NoWarn>$(NoWarn);RS1036;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
