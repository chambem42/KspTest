<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)../../build/KspPlugin.props" />
  <PropertyGroup>
    <RootNamespace>KspTest</RootNamespace>
    <PackageId>KspTest.Trajectories</PackageId>
    <Description>KspTest helpers for Trajectories: its API (TrajApi) and entry accuracy measurements, by reflection, so this loads with or without it.</Description>
    <OutputPath>$(MSBuildThisFileDirectory)../../GameData/KspTest/Plugins/</OutputPath>
    <!-- compile-time only: the harness itself is deployed into GameData by ksptest, never copied with a test assembly -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="ref/net48/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../KspTest/KspTest.csproj" Private="false" />
    <ProjectReference Include="../KspTest.Far/KspTest.Far.csproj" Private="false" />
  </ItemGroup>
</Project>
